---
// Startseiten-Hero: dunkle Metallic-Lackfläche, Überschrift wird „aufgesprüht“,
// rechts ein echtes Schadensfoto (von der alten Website), das per Sprühkegel erscheint.
// Ein kleiner Canvas-Sprühnebel läuft EINMAL beim Laden (ca. 2 s) und stoppt dann –
// bei „Bewegung reduzieren“ oder ohne JS gar nicht.
import { Image } from "astro:assets";
import { SITE, telLink, u, waLink } from "../consts";
import Icon from "./Icon.astro";
import kratzer from "../assets/img/schaden-kratzer.webp";

const checks = ["Meisterbetrieb", "Kostenlose Begutachtung", "Komplette Schadensabwicklung", "Pkw & Wohnmobil"];
---

<section class="hero metallic">
  <canvas class="hero__nebel" aria-hidden="true"></canvas>
  <div class="container hero__grid">
    <div class="hero__text">
      <p class="eyebrow hero__eyebrow">Autolackiererei · Smart-Repair · Unfallservice</p>
      <h1 class="hero__titel">Ihr Lack-Experte<br /> in Norderstedt</h1>
      <p class="lead">
        Fahrzeuglackierung und Schadenmanagement – professionell, transparent, zuverlässig.
        Wir begutachten Ihr Fahrzeug kostenlos und kümmern uns vom Kratzer bis zum Unfallschaden um alles.
      </p>
      <div class="btn-reihe">
        <a class="btn glanz" href={telLink}><Icon name="phone" size={22} /> {SITE.phoneDisplay}</a>
        <a class="btn btn--wa" href={waLink()} target="_blank" rel="noopener"><Icon name="whatsapp" size={22} /> WhatsApp</a>
        <a class="btn btn--glas" href={u("kontakt-anfahrt/#anfrage")}>Termin anfragen <Icon name="arrow" size={20} /></a>
      </div>
      <ul class="hero__checks">
        {checks.map((c) => <li><Icon name="check" size={18} /> {c}</li>)}
      </ul>
    </div>

    <figure class="hero__bild">
      <div class="hero__rahmen bild-spray" style="--sx: 45%; --sy: 55%">
        <Image src={kratzer} alt="Silberner Pkw mit Kratzern und Schrammen am vorderen Stoßfänger und Kotflügel" widths={[444, 666]} sizes="(min-width: 1024px) 460px, 92vw" loading="eager" fetchpriority="high" />
      </div>
      <figcaption>Typischer Lackschaden – ein Fall für Lackreparatur oder Smart-Repair.</figcaption>
    </figure>
  </div>
  <svg class="hero__kante" viewBox="0 0 1440 60" preserveAspectRatio="none" aria-hidden="true" focusable="false">
    <path d="M0 60V38L1440 0v60Z" fill="#fff" />
  </svg>
</section>

<style>
  .hero { position: relative; color: var(--s-200); overflow: hidden; padding: 48px 0 84px; }
  @media (min-width: 1024px) { .hero { padding: 80px 0 120px; } }
  .hero__nebel { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .hero__grid { position: relative; display: grid; gap: 40px; align-items: center; }
  @media (min-width: 1024px) { .hero__grid { grid-template-columns: 1.15fr .85fr; gap: 56px; } }
  .hero h1 { color: var(--weiss); margin-bottom: 22px; display: inline-block; } /* Breite = Text → Sprühbahn und Aufdecken passen genau */
  /* Kundenwunsch: im Hero kein roter Strich über der H1 */
  .hero .hero__eyebrow::before { display: none; }

  /* Ablauf (Kundenwunsch): ERST sprüht die Lackpistole (Canvas, ca. 0–1,3 s),
     DANACH wird die Überschrift aus dem Sprühnebel heraus aufgedeckt (ab 0,6 s).
     Ohne JS bzw. bei „Bewegung reduzieren“: Überschrift sofort sichtbar. */
  :global(html.js) .hero__titel {
    -webkit-mask-image: linear-gradient(90deg, #000 0 40%, rgba(0,0,0,.5) 46%, rgba(0,0,0,.12) 52%, transparent 58%);
            mask-image: linear-gradient(90deg, #000 0 40%, rgba(0,0,0,.5) 46%, rgba(0,0,0,.12) 52%, transparent 58%);
    -webkit-mask-size: 260% 100%; mask-size: 260% 100%;
    -webkit-mask-repeat: no-repeat; mask-repeat: no-repeat;
    -webkit-mask-position: 100% 0; mask-position: 100% 0;
    animation: titel-auf 1.2s cubic-bezier(.45,.1,.3,1) .6s forwards;
  }
  @keyframes titel-auf { to { -webkit-mask-position: 0 0; mask-position: 0 0; } }
  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .hero__titel { -webkit-mask-image: none; mask-image: none; animation: none; }
  }
  .hero .lead { color: var(--s-300); margin-bottom: 28px; }
  .hero__checks { list-style: none; padding: 0; margin: 28px 0 0; display: flex; flex-wrap: wrap; gap: 10px 22px; }
  .hero__checks li { display: inline-flex; align-items: center; gap: 8px; font-weight: 600; color: var(--weiss); font-size: 16px; }
  .hero__checks :global(.icon) { color: var(--rot-auf-dunkel); stroke-width: 3; }

  .hero__bild { margin: 0; position: relative; }
  .hero__rahmen {
    position: relative; border-radius: var(--r-lg); overflow: hidden;
    aspect-ratio: 4 / 3; background: #1b1b20;
    box-shadow: 0 30px 60px rgba(0,0,0,.45), 0 0 0 1px rgba(255,255,255,.08);
    transform: rotate(-1.5deg);
  }
  .hero__rahmen :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .hero__rahmen::after { /* Klarlack-Reflex über dem Foto */
    content: ""; position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(125deg, rgba(255,255,255,.18) 0%, transparent 30%, transparent 70%, rgba(255,255,255,.06) 100%);
  }
  .hero__bild figcaption { margin-top: 16px; font-size: 15px; color: var(--s-300); }
  .hero__bild::before { /* roter Sprühfleck hinter dem Foto */
    content: ""; position: absolute; width: 70%; aspect-ratio: 1; right: -12%; top: -14%;
    background: radial-gradient(closest-side, rgba(200,32,14,.55), rgba(200,32,14,.15) 60%, transparent);
    filter: blur(6px);
  }
  .hero__kante { position: absolute; left: 0; right: 0; bottom: -1px; width: 100%; height: 48px; display: block; }
  .hero :global(.btn) { flex: 1 1 auto; }
  @media (min-width: 560px) { .hero :global(.btn) { flex: 0 0 auto; } }
</style>

<script>
  // Lack-Sprühstoß: eine gedachte Düse fährt einmal über die Überschrift und sprüht
  // feinen Farbnebel + Tröpfchen. Die Überschrift wird per CSS kurz danach aufgedeckt.
  // Läuft nur einmal (~2,3 s), danach wird der Canvas geleert. Kein JS / reduzierte
  // Bewegung → kein Sprühen, Schrift sofort da.
  const cv = document.querySelector<HTMLCanvasElement>(".hero__nebel");
  const titel = document.querySelector<HTMLElement>(".hero__titel");
  const ruhig = matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (cv && titel && !ruhig) {
    const ctx = cv.getContext("2d")!;
    const dpr = Math.min(devicePixelRatio || 1, 2);
    cv.width = cv.clientWidth * dpr;
    cv.height = cv.clientHeight * dpr;
    const W = cv.width, H = cv.height;
    const hr = cv.getBoundingClientRect(), tr = titel.getBoundingClientRect();
    // Sprühbahn: knapp links vor der Überschrift bis über ihr rechtes Ende, leicht oberhalb
    const x0 = Math.max(0, tr.left - hr.left - 40) * dpr;
    const x1 = Math.min(W / dpr, tr.right - hr.left + 30) * dpr;
    const yMitte = (tr.top - hr.top + tr.height * 0.5) * dpr;
    const ySpan = tr.height * 0.42 * dpr;
    type P = { x: number; y: number; vx: number; vy: number; r: number; a: number; c: string; nebel: boolean };
    const teile: P[] = [];
    const farben = ["200,32,14", "226,52,31", "255,107,87", "160,22,10"];
    const start = performance.now();
    const SPRUEH = 1300; // ms Sprühdauer
    const ENDE = 2400;   // ms bis alles verflogen ist
    const schritt = (t: number) => {
      const el = t - start;
      if (el < SPRUEH) {
        const f = el / SPRUEH;
        const e = f < 0.5 ? 2 * f * f : 1 - Math.pow(-2 * f + 2, 2) / 2; // weiche Bewegung
        const nx = x0 + (x1 - x0) * e;
        const ny = yMitte + Math.sin(f * Math.PI * 3) * ySpan * 0.5; // leichtes Schwenken wie beim Lackieren
        for (let i = 0; i < 34; i++) {
          const w = (Math.random() - 0.5) * 1.1 + Math.PI / 2 * 0.15;
          const v = (1.5 + Math.random() * 4.5) * dpr;
          teile.push({ x: nx, y: ny - ySpan, vx: Math.cos(w) * v * 0.6, vy: Math.abs(Math.sin(w)) * v + 1.2 * dpr,
            r: (0.5 + Math.random() * 1.8) * dpr, a: 0.55 + Math.random() * 0.4, c: farben[i % 4], nebel: false });
        }
        for (let i = 0; i < 3; i++) {
          teile.push({ x: nx + (Math.random() - 0.5) * 30 * dpr, y: ny + (Math.random() - 0.5) * ySpan * 1.6,
            vx: (Math.random() - 0.3) * 0.8 * dpr, vy: (Math.random() - 0.5) * 0.6 * dpr,
            r: (18 + Math.random() * 26) * dpr, a: 0.10 + Math.random() * 0.06, c: farben[i % 2], nebel: true });
        }
      }
      ctx.clearRect(0, 0, W, H);
      for (let i = teile.length - 1; i >= 0; i--) {
        const p = teile[i];
        p.x += p.vx; p.y += p.vy;
        if (p.nebel) { p.r *= 1.012; p.a *= 0.975; } else { p.vx *= 0.95; p.vy *= 0.93; p.a *= 0.955; }
        if (p.a < 0.012) { teile.splice(i, 1); continue; }
        ctx.fillStyle = `rgba(${p.c},${p.a})`;
        ctx.beginPath(); ctx.arc(p.x, p.y, p.r, 0, 6.283); ctx.fill();
      }
      if (el < ENDE && (teile.length || el < SPRUEH)) requestAnimationFrame(schritt);
      else ctx.clearRect(0, 0, W, H);
    };
    requestAnimationFrame(schritt);
  }
</script>
