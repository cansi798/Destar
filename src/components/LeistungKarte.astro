---
// Leistungskarte im Stil einer Lack-Farbmusterkarte: Bild, Farbstreifen mit „Farbcode“,
// Titel, Kurztext. Glanzlicht beim Überfahren.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Icon from "./Icon.astro";
interface Props { href: string; titel: string; text: string; icon: string; bild: ImageMetadata; alt: string; nr: number; }
const { href, titel, text, icon, bild, alt, nr } = Astro.props;
---
<a class="lk glanz reveal" href={href}>
  <div class="lk__bild">
    <Image src={bild} alt={alt} widths={[360, 540, 720]} sizes="(min-width: 1024px) 370px, (min-width: 640px) 46vw, 92vw" />
  </div>
  <div class="lk__muster" aria-hidden="true">
    <span class="lk__code">DL-{String(nr).padStart(2, "0")}</span>
    <span class="lk__icon"><Icon name={icon} size={22} /></span>
  </div>
  <div class="lk__text">
    <h3>{titel}</h3>
    <p>{text}</p>
    <span class="lk__mehr">Mehr erfahren <Icon name="arrow" size={18} /></span>
  </div>
</a>

<style>
  .lk {
    display: flex; flex-direction: column;
    background: var(--weiss); color: var(--s-900); text-decoration: none;
    border-radius: 6px 6px var(--r-lg) var(--r-lg);
    box-shadow: var(--shadow-sm), 0 0 0 1px var(--s-200);
    transition: transform var(--t), box-shadow var(--t);
  }
  .lk:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); color: var(--s-900); }
  .lk__bild { aspect-ratio: 16 / 10; overflow: hidden; border-radius: 6px 6px 0 0; background: var(--s-100); }
  .lk__bild :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform .5s ease; }
  .lk:hover .lk__bild :global(img) { transform: scale(1.04); }
  .lk__muster {
    display: flex; justify-content: space-between; align-items: center;
    height: 44px; padding: 0 16px;
    background: linear-gradient(90deg, var(--rot-dunkel), var(--rot) 60%, #e0412c);
    color: var(--weiss);
  }
  .lk__code { font-family: var(--font-head); font-weight: 700; letter-spacing: .18em; font-size: 15px; }
  .lk__text { padding: 20px 20px 22px; display: flex; flex-direction: column; flex: 1; }
  .lk__text h3 { margin-bottom: 8px; }
  .lk__text p { color: var(--s-600); font-size: 16px; flex: 1; }
  .lk__mehr { display: inline-flex; align-items: center; gap: 8px; font-weight: 700; color: var(--rot-dunkel); }
</style>
