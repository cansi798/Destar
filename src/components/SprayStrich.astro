---
// Gesprühter Lackstreifen (SVG): rauer Sprührand per feTurbulence, wird beim
// Sichtbarwerden „aufgesprüht“ (stroke-dashoffset), dazu ein paar Farbtropfen.
// Rein dekorativ (aria-hidden). Bei reduzierter Bewegung: fertiger Streifen.
interface Props { class?: string; id?: string; }
const { class: cls = "", id = "rau" + Math.random().toString(36).slice(2, 7) } = Astro.props;
---
<span class={`strich-wrap ${cls}`} aria-hidden="true">
  <svg viewBox="0 0 600 70" preserveAspectRatio="none" focusable="false">
    <defs>
      <filter id={id} x="-5%" y="-40%" width="110%" height="180%">
        <feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="2" seed="7" result="n" />
        <feDisplacementMap in="SourceGraphic" in2="n" scale="12" xChannelSelector="R" yChannelSelector="G" />
      </filter>
    </defs>
    <path class="strich" d="M14 44 C140 22 300 52 586 24" pathLength="1" filter={`url(#${id})`} />
    <g class="tropfen" filter={`url(#${id})`}>
      <circle cx="604" cy="16" r="3" /><circle cx="560" cy="48" r="2.2" /><circle cx="590" cy="44" r="1.6" />
      <circle cx="40" cy="20" r="1.8" /><circle cx="300" cy="62" r="1.5" /><circle cx="450" cy="12" r="2" />
    </g>
  </svg>
</span>

<style>
  .strich-wrap { display: block; width: min(100%, 380px); height: 26px; color: var(--rot); }
  .strich-wrap svg { width: 100%; height: 100%; overflow: visible; display: block; }
  .strich { fill: none; stroke: currentColor; stroke-width: 16; stroke-linecap: round; }
  .tropfen { fill: currentColor; }
  :global(html.js) .strich { stroke-dasharray: 1; stroke-dashoffset: 1; }
  :global(html.js) .tropfen { opacity: 0; }
  :global(html.js) .strich-wrap:global(.ist-sichtbar) .strich { animation: strich 0.9s cubic-bezier(.5,.1,.3,1) .2s forwards; }
  :global(html.js) .strich-wrap:global(.ist-sichtbar) .tropfen { animation: tropfen .4s ease 1s forwards; }
  @keyframes strich { to { stroke-dashoffset: 0; } }
  @keyframes tropfen { to { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .strich { stroke-dashoffset: 0; animation: none; }
    :global(html.js) .tropfen { opacity: 1; }
  }
</style>
