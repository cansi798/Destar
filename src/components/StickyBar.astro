---
// Feste Kontaktleiste unten auf Handy/Tablet: Anrufen · WhatsApp · Anfrage.
import { telLink, u, waLink } from "../consts";
import Icon from "./Icon.astro";
---

<nav class="sb" aria-label="Schnellkontakt">
  <a class="sb__btn sb__btn--tel" href={telLink}><Icon name="phone" size={22} /><span>Anrufen</span></a>
  <a class="sb__btn sb__btn--wa" href={waLink()} target="_blank" rel="noopener"><Icon name="whatsapp" size={22} /><span>WhatsApp</span></a>
  <a class="sb__btn" href={u("kontakt-anfahrt/#anfrage")}><Icon name="mail" size={22} /><span>Anfrage</span></a>
</nav>

<style>
  .sb {
    position: fixed; inset: auto 0 0 0; z-index: 90;
    display: grid; grid-template-columns: 1.15fr 1fr 1fr; gap: 6px;
    height: calc(var(--stickybar-h) + env(safe-area-inset-bottom));
    padding: 8px 8px calc(8px + env(safe-area-inset-bottom));
    background: var(--s-950);
    box-shadow: 0 -6px 20px rgba(0, 0, 0, .18);
  }
  .sb__btn {
    display: flex; align-items: center; justify-content: center; gap: 8px;
    border-radius: var(--r);
    background: var(--s-800);
    color: var(--weiss); text-decoration: none;
    font-family: var(--font-head); font-weight: 700; font-size: 17px; letter-spacing: .03em; text-transform: uppercase;
  }
  .sb__btn:hover { color: var(--weiss); }
  .sb__btn--tel { background: var(--rot); }
  .sb__btn--wa { background: #1B7F43; }
  @media (max-width: 359px) { .sb__btn span { font-size: 15px; } .sb__btn { gap: 5px; } }
  @media (min-width: 1024px) { .sb { display: none; } }
</style>
