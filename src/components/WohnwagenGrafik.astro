---
// Gezeichneter Wohnwagen (eigene SVG-Grafik, kein Foto): Beim Sichtbarwerden wird die
// Kontur gezogen, dann fährt eine Lackierpistole entlang und sprüht den roten Zierstreifen
// auf, zum Schluss läuft ein Glanzlicht über den „frischen Lack“. Ohne JS bzw. bei
// „Bewegung reduzieren“: fertiges Endbild. Rein dekorativ (aria-hidden).
interface Props { class?: string; }
const { class: cls = "" } = Astro.props;
const id = "ww" + Math.random().toString(36).slice(2, 7); // eindeutige IDs, falls mehrfach auf einer Seite
---
<div class={`ww anim ${cls}`.trim()} aria-hidden="true">
  <svg viewBox="0 0 320 180" focusable="false">
    <defs>
      <clipPath id={`${id}-k`}><path d="M40 136V62q0-22 22-22h166q34 0 40 40l4 56Z" /></clipPath>
      <linearGradient id={`${id}-g`} x1="0" x2="1"><stop offset="0" stop-color="#fff" stop-opacity="0" /><stop offset=".5" stop-color="#fff" stop-opacity=".55" /><stop offset="1" stop-color="#fff" stop-opacity="0" /></linearGradient>
    </defs>
    <path class="ww__boden" d="M0 158h320" />
    <g clip-path={`url(#${id}-k)`}>
      <rect x="30" y="34" width="250" height="110" fill="#f4f4f6" />
      <rect class="ww__streifen" x="30" y="104" width="250" height="14" />
      <rect class="ww__streifen ww__streifen--2" x="30" y="121" width="250" height="5" />
      <rect class="ww__glanz" x="-60" y="30" width="50" height="120" fill={`url(#${id}-g)`} transform="skewX(-18)" />
    </g>
    <g class="ww__linie">
      <path d="M40 136V62q0-22 22-22h166q34 0 40 40l4 56Z" pathLength="1" />
      <rect x="64" y="58" width="62" height="34" rx="5" pathLength="1" />
      <rect x="150" y="58" width="36" height="74" rx="4" pathLength="1" />
      <path d="M204 58h30q18 0 24 22h-54Z" pathLength="1" />
      <path d="M40 128H12m6 0v18" pathLength="1" />
    </g>
    <g class="ww__rad">
      <circle cx="112" cy="142" r="16" />
      <circle cx="112" cy="142" r="6" />
    </g>
    <g class="ww__pistole">
      <g class="ww__nebel">
        <circle cx="-4" cy="20" r="2" /><circle cx="4" cy="26" r="1.6" /><circle cx="-8" cy="30" r="1.3" /><circle cx="2" cy="34" r="1.8" /><circle cx="9" cy="22" r="1.2" />
      </g>
      <path class="ww__pistole-form" d="M-10 -14h20a4 4 0 0 1 4 4v4H-14v-4a4 4 0 0 1 4-4ZM-6 -6v5l-2 12h8l-2-12v-5M-4 -14v-6h5v6" />
    </g>
  </svg>
</div>

<style>
  .ww { width: 100%; overflow: hidden; } /* Glanz/Pistole am Ende nicht über den Rand */
  .ww svg { display: block; width: 100%; height: auto; overflow: visible; }
  .ww__boden { stroke: rgba(255,255,255,.25); stroke-width: 2; stroke-dasharray: 2 8; fill: none; }
  .ww__linie { fill: none; stroke: var(--weiss); stroke-width: 3.5; stroke-linejoin: round; stroke-linecap: round; }
  .ww__linie path:first-child { stroke-width: 4; }
  .ww__rad circle:first-child { fill: #26262b; stroke: var(--weiss); stroke-width: 3.5; }
  .ww__rad circle:last-child { fill: var(--s-400); }
  .ww__streifen { fill: var(--rot); transform-box: fill-box; transform-origin: left center; }
  .ww__streifen--2 { fill: #e0412c; }
  .ww__pistole { transform: translate(282px, 82px); opacity: 0; }
  .ww__pistole-form { fill: var(--s-200); stroke: var(--s-950); stroke-width: 1.4; stroke-linejoin: round; }
  .ww__nebel circle { fill: rgba(255,107,87,.8); }
  .ww__glanz { opacity: 0; }

  /* Animation nur mit JS (Klasse .ist-sichtbar vom IntersectionObserver) */
  :global(html.js) .ww .ww__linie > * { stroke-dasharray: 1; stroke-dashoffset: 1; }
  :global(html.js) .ww .ww__streifen { transform: scaleX(0); }
  :global(html.js) .ww:global(.ist-sichtbar) .ww__linie > * { animation: ww-zeichnen 1.1s ease forwards; }
  :global(html.js) .ww:global(.ist-sichtbar) .ww__streifen { animation: ww-spruehen 1.3s cubic-bezier(.45,.1,.3,1) 1s forwards; }
  :global(html.js) .ww:global(.ist-sichtbar) .ww__streifen--2 { animation-delay: 1.15s; }
  :global(html.js) .ww:global(.ist-sichtbar) .ww__pistole { animation: ww-pistole 1.5s cubic-bezier(.45,.1,.3,1) .9s both; }
  :global(html.js) .ww:global(.ist-sichtbar) .ww__nebel { animation: ww-nebel .18s steps(2) .9s 8 alternate; }
  :global(html.js) .ww:global(.ist-sichtbar) .ww__glanz { animation: ww-glanz 1.2s ease 2.5s both; }
  @keyframes ww-zeichnen { to { stroke-dashoffset: 0; } }
  @keyframes ww-spruehen { to { transform: scaleX(1); } }
  @keyframes ww-pistole {
    0% { opacity: 0; transform: translate(34px, 82px); }
    10% { opacity: 1; }
    85% { opacity: 1; transform: translate(276px, 82px); }
    100% { opacity: 0; transform: translate(300px, 70px); }
  }
  @keyframes ww-nebel { to { transform: translate(2px, 3px); opacity: .5; } }
  @keyframes ww-glanz { 0% { opacity: 0; transform: skewX(-18deg) translateX(0); } 20% { opacity: 1; } 100% { opacity: 0; transform: skewX(-18deg) translateX(380px); } }
  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .ww .ww__linie > * { stroke-dashoffset: 0; }
    :global(html.js) .ww .ww__streifen { transform: none; }
    .ww__pistole, .ww__glanz { display: none; }
  }
</style>
