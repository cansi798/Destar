---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { u } from "../consts";
---
<BaseLayout title="Seite nicht gefunden | Destar Lackdoktor" description="Diese Seite gibt es nicht (mehr)." noindex>
  <PageHero titel="Hier ist ein" akzent="Kratzer im Lack" lead="Die gesuchte Seite gibt es leider nicht (mehr). Kein Problem – hier geht es weiter:" />
  <section class="section">
    <div class="container btn-reihe">
      <a class="btn" href={u("")}>Zur Startseite</a>
      <a class="btn btn--rahmen" href={u("leistungen/")}>Unsere Leistungen</a>
      <a class="btn btn--rahmen" href={u("kontakt-anfahrt/")}>Kontakt & Anfahrt</a>
    </div>
  </section>
</BaseLayout>
