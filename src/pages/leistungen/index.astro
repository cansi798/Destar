---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
// 16.10.2026: Ablauf entfernt (steht einmal auf der Startseite unter #ablauf).
import LeistungKarte from "../../components/LeistungKarte.astro";
import CtaBand from "../../components/CtaBand.astro";
import { u } from "../../consts";
import pistole from "../../assets/img/lackierpistole-4x3.webp";

const leistungen = (await getCollection("leistungen")).sort((a, b) => a.data.order - b.data.order);
const crumbs = [{ name: "Leistungen", href: u("leistungen/") }];
---

<BaseLayout
  title="Leistungen: Lack, Smart-Repair, Karosserie, Autoglas | Destar Lackdoktor"
  description="Alle Leistungen von Destar Lackdoktor in Norderstedt: Unfallservice, Smart-Repair, Lackierarbeiten, Karosserie, Autoglas sowie Wohnwagen- und Wohnmobil-Lackierung."
  crumbs={crumbs}
>
  <PageHero
    eyebrow="Leistungen"
    titel="Alles rund um"
    akzent="Lack & Karosserie"
    lead="Vom Kratzer bis zum Unfallschaden: Wir lösen das Problem – und kümmern uns um alles Drumherum gleich mit."
    bild={pistole}
    alt="Hand eines Lackierers mit Lackierpistole"
    crumbs={crumbs}
  />

  <section class="section">
    <div class="container">
      <div class="grid g-3 gap-lg">
        {leistungen.map((l, i) => (
          <LeistungKarte href={u(`leistungen/${l.id}/`)} problem={l.data.problem} titel={l.data.kurz} text={l.data.teaser} icon={l.data.icon} bild={l.data.bild} alt={l.data.bildAlt} nr={i + 1} />
        ))}
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
